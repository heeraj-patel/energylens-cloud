# Copy to .env-local for local API/worker runs. Keep it mode 0600.
# The launcher sources this Bash file; replace required values with your own.
# Migrations use a separate private cloud-migrate.env, never this file.

# Runtime and database (Cloud API/worker)
ENERGYLENS_CLOUD_ENV=dev
ENERGYLENS_CLOUD_BIND=127.0.0.1:18092
# For a concurrent worker use a separate private worker env and bind 127.0.0.1:18092.
ENERGYLENS_CLOUD_DATABASE_URL=
# ENERGYLENS_CLOUD_ROLE=api
# RUNTIME_ENV=local

# HTTPS, Hub trust, and owner API cursor key (API role)
ENERGYLENS_CLOUD_TLS_CERT=
ENERGYLENS_CLOUD_TLS_KEY=
ENERGYLENS_CLOUD_HUB_CLIENT_CA=
ENERGYLENS_CLOUD_HUB_SIGN_CERT=
ENERGYLENS_CLOUD_HUB_SIGN_KEY=
ENERGYLENS_CLOUD_METERED_EXPORT_CURSOR_KEY_FILE=
# ENERGYLENS_CLOUD_METERED_EXPORT_PREVIOUS_CURSOR_KEY_FILE=

# Configure one real owner authentication mode. Local auth is development only.
# ENERGYLENS_CLOUD_OIDC_ISSUER=
# ENERGYLENS_CLOUD_OIDC_AUDIENCE=
# ENERGYLENS_CLOUD_OIDC_JWKS_URL=
# ENERGYLENS_CLOUD_LOCAL_AUTH_ENABLED=false
# ENERGYLENS_CLOUD_LOCAL_AUTH_ACTIVE_KEY_ID=
# ENERGYLENS_CLOUD_LOCAL_AUTH_PRIVATE_KEY_FILE=
# ENERGYLENS_CLOUD_LOCAL_AUTH_PUBLIC_KEY_FILES=
# ENERGYLENS_CLOUD_RUNTIME_LOCAL_AUTH_AUDIENCE=
# ENERGYLENS_CLOUD_LOCAL_AUTH_AUDIENCE=
# ENERGYLENS_CLOUD_LOCAL_AUTH_LINK_ORIGIN=
# ENERGYLENS_CLOUD_LOCAL_AUTH_REGISTER_RATE_KEY_FILE=
# ENERGYLENS_CLOUD_LOCAL_AUTH_LOGIN_RATE_KEY_FILE=
# ENERGYLENS_CLOUD_LOCAL_AUTH_RECOVERY_RATE_KEY_FILE=
# ENERGYLENS_CLOUD_LOCAL_AUTH_TRUSTED_PROXY_CIDRS=
# ENERGYLENS_CLOUD_LOCAL_AUTH_MAIL_ENABLED=false
# ENERGYLENS_CLOUD_LOCAL_AUTH_RESEND_API_KEY=
# ENERGYLENS_CLOUD_LOCAL_AUTH_RESEND_FROM=

# Optional worker jobs
# ENERGYLENS_CLOUD_DATAWIZ_REQUESTS_DIR=
# ENERGYLENS_CLOUD_METERED_ROLLUP_ENABLED=false
# ENERGYLENS_CLOUD_KASA_RUNTIME_RETENTION_ENABLED=false
# ENERGYLENS_CLOUD_REPORT_RETENTION_ENABLED=false

# Optional API integrations and guarded features
# ENERGYLENS_CLOUD_OPEN_METEO_API_KEY=
# ENERGYLENS_CLOUD_WEATHER_COARSE_CELLS=
# ENERGYLENS_CLOUD_REPORT_DELIVERY_ENABLED=false
# ENERGYLENS_CLOUD_REPORT_DIRECT_SEND_ENABLED=false
# ENERGYLENS_CLOUD_RESEND_API_KEY=
# ENERGYLENS_CLOUD_RESEND_FROM=
# ENERGYLENS_CLOUD_ACCOUNT_DELETION_ENABLED=false
# ENERGYLENS_CLOUD_DELETION_JOURNAL_DIR=
# ENERGYLENS_CLOUD_DELETION_JOURNAL_KEY_FILE=
# ENERGYLENS_CLOUD_SAMPLE_FIXTURES_ENABLED=false
# ENERGYLENS_CLOUD_SAMPLE_FIXTURE_HOME_IDS=
# ENERGYLENS_CLOUD_SAMPLE_FIXTURE_USER_IDS=

# Operator-only or test settings: set only for the relevant command, not the
# serving .env-local. See the role templates in energylens-dev-bash-scripts.
# ENERGYLENS_CLOUD_MIGRATION_DATABASE_URL=
# ENERGYLENS_CLOUD_TEST_DATABASE_URL=
# ENERGYLENS_CLOUD_TEST_POSTGRES_DATA_DIR=
# ENERGYLENS_HUB_E2E_BATCH_PATH=
# ENERGYLENS_WAP_CAPTURE_PATH=
# ENERGYLENS_WAP_STAGING_ARTIFACT=

# Deprecated Cloud Hub listener settings; leave unset.
# ENERGYLENS_CLOUD_HUB_BIND=
# ENERGYLENS_CLOUD_HUB_TLS_CERT=
# ENERGYLENS_CLOUD_HUB_TLS_KEY=

# Legacy development auth settings; local auth above is the supported path.
# ENERGYLENS_CLOUD_DEV_AUTH_ENABLED=false
# ENERGYLENS_CLOUD_DEV_AUTH_EMAIL=
# ENERGYLENS_CLOUD_DEV_AUTH_PASSWORD=
